# TLS_MODE=names or domain: HTTPS on HTTPS_PORT with the wildcard certificate
# the names agent keeps in /data/tls; HTTP_PORT redirects to it. The admin API is a
# socket in /tmp, only for `caddy reload` after a renewal (cert-changed.sh).
{
	admin unix//tmp/caddy-admin.sock
	persist_config off
	storage file_system /data/caddy
	http_port {$HTTP_PORT}
	https_port {$HTTPS_PORT}
	auto_https disable_certs
}

http://127.0.0.1:{$HEALTH_PORT} {
	bind 127.0.0.1
	respond 200
}

https://{$TLS_HOSTNAME}, https://*.{$TLS_HOSTNAME} {
	tls /data/tls/cert.pem /data/tls/key.pem
	import /app/caddy/routes.caddy
}
