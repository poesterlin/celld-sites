# TLS_MODE=off: plain HTTP on HTTP_PORT, for a proxy in front that terminates TLS.
{
	admin off
	auto_https off
	persist_config off
	storage file_system /data/caddy
}

http://127.0.0.1:{$HEALTH_PORT} {
	bind 127.0.0.1
	respond 200
}

http://:{$HTTP_PORT} {
	import /app/caddy/routes.caddy
}

import /app/caddy/panel.caddy
