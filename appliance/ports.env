# The appliance's ports. Only HTTP_PORT and HTTPS_PORT are reachable from
# outside; the rest are loopback, in an unusual range so they do not collide
# with other services when the container shares the host's network (Home
# Assistant). Sourced by start.sh, with-env and health.sh.
: "${HTTP_PORT:=8000}" "${HTTPS_PORT:=8443}"
S3_PORT=47170 CELLD_PORT=47180 CELLD_INTERNAL_PORT=47181 HAMSTR_PORT=47130 HEALTH_PORT=47101
# Home Assistant's sidebar panel (ingress_port in ha-addon/config.yaml).
INGRESS_PORT=8099
export HTTP_PORT HTTPS_PORT S3_PORT CELLD_PORT CELLD_INTERNAL_PORT HAMSTR_PORT HEALTH_PORT INGRESS_PORT
