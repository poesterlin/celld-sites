{
	"name": "site-router",
	"main": "index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"worker_loaders": [{ "binding": "LOADER" }],
	"kv_namespaces": [{ "binding": "CODE", "id": "code" }],
	"durable_objects": {
		"bindings": [{ "name": "SITE_OBJECTS", "class_name": "SiteObject" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["SiteObject"] }],
	"vars": { "ADMIN_TOKEN_SHA256": "@ADMIN_TOKEN_SHA256@", "READ_TOKEN_SHA256": "@READ_TOKEN_SHA256@", "ADMIN_HOST": "@ADMIN_HOST@", "DEFAULT_SITE": "@DEFAULT_SITE@", "OPERATOR_URL": "@OPERATOR_URL@", "SITE_TIMEOUT_SECS": "@SITE_TIMEOUT_SECS@", "SITE_MAX_INFLIGHT": "@SITE_MAX_INFLIGHT@", "SITE_MAX_OBJECTS": "@SITE_MAX_OBJECTS@", "SITE_MAX_SUBREQUESTS": "@SITE_MAX_SUBREQUESTS@", "PROXY_TOKEN_SHA256": "@PROXY_TOKEN_SHA256@", "PROXY_SITE_PREFIX": "@PROXY_SITE_PREFIX@", "AUTH_URL": "@AUTH_URL@", "AUTH_KEY": "@AUTH_KEY@" }
}
