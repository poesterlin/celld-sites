# The zone this service is authoritative for. Delegate it to this server with
# NS records at the registrar (or at the parent zone), pointing at NAMESERVERS.
ZONE=hamstr.example

# Name servers for the zone (comma-separated). Each needs an A/AAAA record in
# RECORDS below (glue at the registrar too, if they sit inside the zone).
NAMESERVERS=ns1.hamstr.example

# Fixed records: "name TYPE value", comma-separated; "@" is the zone itself.
# Names used here are never handed out as install ids.
RECORDS=ns1 A 203.0.113.10, names A 203.0.113.10

# Contact address in the SOA record, with the "@" written as a dot.
# HOSTMASTER=hostmaster.hamstr.example

# TTL for every record, in seconds.
# TTL=60

# Set when the API sits behind a reverse proxy or Cloudflare, so registration
# rate limits use the client's address instead of the proxy's.
# TRUST_PROXY=false

# Registrations allowed per client address and hour.
# REGISTER_PER_HOUR=10

# Installs that have not called the API for this many days are released.
# Agents refresh their address every few hours, so only dead installs expire.
# EXPIRE_DAYS=90

# Only for testing: also accept public addresses. Leave off in production:
# private-only is what keeps the zone from pointing at anything on the internet.
# ALLOW_PUBLIC_ADDRESSES=false
