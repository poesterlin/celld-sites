# Credentials for the internal S3 bucket (VersityGW root user). Any random strings.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Token for the router's deploy API (A-Z a-z 0-9 _ - only).
ADMIN_TOKEN=
# Hostname the bundled example site is deployed to (LAN only). Development stack
# only: the production stack bundles no example and ignores this.
HOST_DOMAIN=celld-test.example.com
# Traefik rule for all site hostnames (defaults to HOST_DOMAIN only). Use a
# pattern so new sites and aliases need no restart; single quotes keep the `$`.
# Hostnames outside the pattern can be added: ... || Host(`blog.other.com`)
SITES_RULE='HostRegexp(`^celld-[a-z0-9-]+\.example\.com$`)'
# Flush each bucket object to disk before acknowledging it (safe default).
# false = faster writes, but a VM crash can lose the last seconds of writes.
# S3_FSYNC=true
# Read-only token for the admin API (dashboard). Same charset as ADMIN_TOKEN.
READ_TOKEN=
# Hostname of the read-only dashboard (no auth: keep it LAN-only).
DASHBOARD_HOST=celld-admin.example.com
# Memory limit of the celld node (each loaded EmDash site ~120 MB).
# CELLD_MEM_LIMIT=8g
# Per-isolate V8 heap limit in MB (celld's default is 128; an EmDash site is
# ~120 MB once loaded, so it gets headroom for query result sets).
# CELLD_V8_HEAP_LIMIT_MB=256
# Per-site limits (defaults shown); a site over them gets 503s or errors, the
# rest of the node is unaffected.
# SITE_TIMEOUT_SECS=30
# SITE_MAX_INFLIGHT=128
# SITE_MAX_OBJECTS=1000
# SITE_MAX_SUBREQUESTS=1000
# Cubby app store (LAN-only by default). Its hostname must not match SITES_RULE.
# See cubby/README.md. Generate an admin token with: openssl rand -base64 24
CUBBY_HOST=cubby.example.com
# Enables release review, takedown and the reports inbox; empty = disabled.
CUBBY_ADMIN_TOKEN=
# 1: new releases wait for admin approval (recommended once the store is public).
CUBBY_REQUIRE_REVIEW=0
# Cubby Shelf: the local install/preview UI (LAN-only; it holds the admin token).
CUBBY_SHELF_HOST=cubby-shelf.example.com
# Base domain used to suggest a hostname for a new app (celld-<app>.<domain>).
CUBBY_APP_DOMAIN=example.com
# Generate with: openssl rand -base64 24
CUBBY_SHELF_PASSWORD=
CUBBY_SHELF_SECRET=
# Interactive demo node (store "Try it live"). Separate bucket, state and token.
DEMO_ADMIN_TOKEN=
DEMO_READ_TOKEN=
CUBBY_DEMO_DOMAIN=example.com
CUBBY_DEMO_TTL_SECS=900
CUBBY_DEMO_MAX=8
CUBBY_DEMO_PER_HOUR=6
# Hamstr: the personal app shell (grains, tsidp sign-in, share links). LAN-only.
# Enable it with the compose profile; see hamstr/README.md.
# COMPOSE_PROFILES=hamstr
HAMSTR_HOST=hamstr.example.com
# Grains live at grain-<id>.<HAMSTR_GRAIN_DOMAIN>; the rule must match exactly those.
HAMSTR_GRAIN_DOMAIN=example.com
HAMSTR_GRAINS_RULE='HostRegexp(`^grain-[a-z0-9]{12}[.]example[.]com$`)'
# Generate both with: openssl rand -base64 32 | tr -d '/+='
HAMSTR_PROXY_TOKEN=
HAMSTR_SECRET=
# OIDC client registered at the IdP (tsidp), redirect URI https://<HAMSTR_HOST>/auth/callback
HAMSTR_OIDC_ISSUER=https://idp.example.ts.net
HAMSTR_OIDC_CLIENT_ID=
HAMSTR_OIDC_CLIENT_SECRET=
# Comma-separated emails or usernames ("*" = everyone who can sign in). Admins
# install apps; if ALLOWED_USERS is set, only those people (and admins) can sign in.
HAMSTR_ADMINS=
HAMSTR_ALLOWED_USERS=
