# Credentials for the internal S3 bucket (VersityGW root user). Any random strings.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Token for the router's deploy API (A-Z a-z 0-9 _ - only).
ADMIN_TOKEN=
# Hostname of the test site (tools/deploy.sh sites/example $HOST_DOMAIN) and the
# default SITES_RULE when that is unset (LAN only).
HOST_DOMAIN=celld-test.example.com
# Traefik rule for all site hostnames (defaults to HOST_DOMAIN only). Use a
# pattern so new sites and aliases need no restart; single quotes keep the `$`.
# Exclude the dashboard host (DASHBOARD_HOST) if the pattern matches it.
# Hostnames outside the pattern can be added: ... || Host(`blog.other.com`)
SITES_RULE='HostRegexp(`^celld-[a-z0-9-]+\.example\.com$`) && !Host(`celld-admin.example.com`)'
# Flush each bucket object to disk before acknowledging it (safe default).
# false = faster writes, but a VM crash can lose the last seconds of writes.
# S3_FSYNC=true
# Read-only token for the admin API (dashboard). Same charset as ADMIN_TOKEN.
READ_TOKEN=
# Password for the dashboard (HTTP Basic, user admin or DASHBOARD_USER); at least
# 12 characters: openssl rand -hex 24
DASHBOARD_PASSWORD=
# Hostname of the read-only dashboard (no auth: keep it LAN-only).
DASHBOARD_HOST=celld-admin.example.com
# Memory limit of the celld node (each loaded EmDash site ~120 MB).
# CELLD_MEM_LIMIT=8g
# Per-isolate V8 heap limit in MB (celld's default is 128; an EmDash site is
# ~120 MB once loaded, so it gets headroom for query result sets).
# CELLD_V8_HEAP_LIMIT_MB=256
# Per-site limits (defaults shown); a site over them gets 503s or errors, the
# rest of the node is unaffected.
# SITE_TIMEOUT_SECS=30
# SITE_MAX_INFLIGHT=128
# SITE_MAX_OBJECTS=1000
# SITE_MAX_SUBREQUESTS=1000
# Hamstr Store: the app catalog (LAN-only by default), only for a host that
# runs the store (COMPOSE_PROFILES includes "store"). Its hostname must not
# match SITES_RULE. See store/README.md. Generate an admin token with:
# openssl rand -base64 24
STORE_HOST=store.example.com
# Enables release review, takedown and the reports inbox; empty = disabled.
STORE_ADMIN_TOKEN=
# 1: new releases wait for admin approval (recommended once the store is public).
STORE_REQUIRE_REVIEW=0
# Interactive demo node (store "Try it live"). Separate bucket, state and token.
DEMO_ADMIN_TOKEN=
DEMO_READ_TOKEN=
STORE_DEMO_DOMAIN=example.com
STORE_DEMO_TTL_SECS=900
STORE_DEMO_MAX=8
STORE_DEMO_PER_HOUR=6
# Hamstr: the personal app shell (grains, tsidp sign-in). LAN-only.
# Enable it with the compose profile ("hamstr,store" to also run the store);
# see hamstr/README.md.
# COMPOSE_PROFILES=hamstr
# The store Hamstr gets apps from. Defaults to the store in this stack; a
# personal node without the "store" profile points at a hosted one.
# HAMSTR_STORE=https://store.example.com
# HAMSTR_STORE_PUBLIC=https://store.example.com
HAMSTR_HOST=hamstr.example.com
# Grains live at grain-<id>.<HAMSTR_GRAIN_DOMAIN>; the rule must match exactly those.
HAMSTR_GRAIN_DOMAIN=example.com
HAMSTR_GRAINS_RULE='HostRegexp(`^grain-[a-z0-9]{12}[.]example[.]com$`)'
# Generate both with: openssl rand -base64 32 | tr -d '/+='
HAMSTR_PROXY_TOKEN=
HAMSTR_SECRET=
# OIDC client registered at the IdP (tsidp), redirect URI https://<HAMSTR_HOST>/auth/callback
HAMSTR_OIDC_ISSUER=https://idp.example.ts.net
HAMSTR_OIDC_CLIENT_ID=
HAMSTR_OIDC_CLIENT_SECRET=
# Comma-separated emails or usernames ("*" = everyone who can sign in). Admins
# install apps; if ALLOWED_USERS is set, only those people (and admins) can sign in.
HAMSTR_ADMINS=
HAMSTR_ALLOWED_USERS=

# Sign-in layer. AUTH_URL is the auth service origin (https://<AUTH_HOST>); AUTH_KEY is the
# HMAC key shared by the router and the auth service (openssl rand -hex 32).
AUTH_URL=
AUTH_KEY=

# Auth service (profile "auth"): sign-in, people and per-site access for sites
# that declare `auth` in celld.json. LAN-only. The router and the service share
# AUTH_KEY, so a restart of celld picks it up (see docs/SITES.md "Sign-in").
# COMPOSE_PROFILES=auth            (add ",tsidp" to run Tailscale's OIDC provider too)
AUTH_HOST=auth.example.com
# Where "someone is waiting for approval" goes (an ntfy topic URL; empty = no notification).
AUTH_NTFY_URL=
# First sign-in provider, seeded on a fresh install only (later: Providers page).
AUTH_OIDC_NAME=Tailscale
AUTH_OIDC_ISSUER=https://idp.example.ts.net
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_AUTO_APPROVE=0
# tsidp (profile "tsidp"): the tailnet hostname and the file holding its auth key.
# TSIDP_HOSTNAME=idp
# TSIDP_FUNNEL=1 publishes the IdP on the internet (Tailscale Funnel); off by default.
# TSIDP_AUTHKEY_FILE=./secrets/ts_authkey
