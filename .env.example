# Credentials for the internal S3 bucket (VersityGW root user). Any random strings.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Token for the router's deploy API (A-Z a-z 0-9 _ - only).
ADMIN_TOKEN=
# Hostname the bundled example site is deployed to (LAN only). Development stack
# only: the production stack bundles no example and ignores this.
HOST_DOMAIN=celld-test.example.com
# Traefik rule for all site hostnames (defaults to HOST_DOMAIN only). Use a
# pattern so new sites and aliases need no restart; single quotes keep the `$`.
# Hostnames outside the pattern can be added: ... || Host(`blog.other.com`)
SITES_RULE='HostRegexp(`^celld-[a-z0-9-]+\.example\.com$`)'
# Flush each bucket object to disk before acknowledging it (safe default).
# false = faster writes, but a VM crash can lose the last seconds of writes.
# S3_FSYNC=true
# Read-only token for the admin API (dashboard). Same charset as ADMIN_TOKEN.
READ_TOKEN=
# Hostname of the read-only dashboard (no auth: keep it LAN-only).
DASHBOARD_HOST=celld-admin.example.com
# Memory limit of the celld node (each loaded EmDash site ~120 MB).
# CELLD_MEM_LIMIT=8g
# Per-isolate V8 heap limit in MB (celld's default is 128; an EmDash site is
# ~120 MB once loaded, so it gets headroom for query result sets).
# CELLD_V8_HEAP_LIMIT_MB=256
# Per-site limits (defaults shown); a site over them gets 503s or errors, the
# rest of the node is unaffected.
# SITE_TIMEOUT_SECS=30
# SITE_MAX_INFLIGHT=128
# SITE_MAX_OBJECTS=1000
# SITE_MAX_SUBREQUESTS=1000
