{
	"name": "hamstr",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node server.ts",
		"prepare": "svelte-kit sync || echo ''",
		"test": "npm run build && node --test test/*.test.ts",
		"e2e": "npm run build && node test/e2e.ts",
		"playground": "npm run build && node test/dev.ts",
		"sync-ui": "node ../packages/ui/sync.ts static",
		"predev": "npm run sync-ui",
		"prebuild": "npm run sync-ui"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"devDependencies": {
		"@hamstr/ui": "file:../packages/ui",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"svelte": "^5.57.1",
		"vite": "^8.3.0"
	}
}
